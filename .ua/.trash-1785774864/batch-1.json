{
  "nodes": [
    {"id":"file:app.py","type":"file","name":"app.py","filePath":"app.py","summary":"Hosts the Flask dashboard that coordinates dataset-backed patient selection, model prediction, SHAP explanations, what-if simulation, current and scenario SMPL twins, and the temporary Stage 4 graph.","tags":["entry-point","api-handler","dashboard","orchestration"],"complexity":"complex","languageNotes":"Uses lazy singleton loading for the large model and server-side validation for numbered patient rows and uploaded CSV datasets."},
    {"id":"class:app.py:PatientDataset","type":"class","name":"PatientDataset","filePath":"app.py","lineRange":[64,139],"summary":"Validates an active BRFSS patient table, enforces feature ranges, and exposes stable one-based patient lookup, labels, and nearby-row summaries for the dashboard.","tags":["data-model","validation","patient-data","service"],"complexity":"moderate"},
    {"id":"function:app.py:get_patient_dataset","type":"function","name":"get_patient_dataset","filePath":"app.py","lineRange":[145,149],"summary":"Lazily loads and caches the default BRFSS dataset as the dashboard's active numbered patient source.","tags":["factory","data-loading","singleton"],"complexity":"simple"},
    {"id":"function:app.py:get_twin","type":"function","name":"get_twin","filePath":"app.py","lineRange":[152,157],"summary":"Lazily constructs and caches the model-backed Digital Twin when prediction is first requested.","tags":["factory","singleton","model-loading"],"complexity":"simple"},
    {"id":"function:app.py:twin_metadata","type":"function","name":"twin_metadata","filePath":"app.py","lineRange":[160,171],"summary":"Reads optional metadata beside a GLB twin and adds a modification-time version token, with resilient fallbacks for missing or malformed metadata.","tags":["serialization","utility","digital-twin"],"complexity":"simple"},
    {"id":"function:app.py:digital_twin_asset","type":"function","name":"digital_twin_asset","filePath":"app.py","lineRange":[175,178],"summary":"Serves the current-patient GLB Digital Twin through a conditional Flask response or returns 404 when unavailable.","tags":["api-handler","digital-twin","asset-serving"],"complexity":"simple"},
    {"id":"function:app.py:scenario_digital_twin_asset","type":"function","name":"scenario_digital_twin_asset","filePath":"app.py","lineRange":[182,185],"summary":"Serves the independently generated scenario-profile GLB Digital Twin through the dashboard.","tags":["api-handler","digital-twin","asset-serving"],"complexity":"simple"},
    {"id":"function:app.py:refresh_smpl_twin","type":"function","name":"refresh_smpl_twin","filePath":"app.py","lineRange":[188,273],"summary":"Regenerates a patient-specific SMPL GLB from BMI, sex, and modeled risk, reusing matching output and falling back from direct Python export to Docker Compose.","tags":["digital-twin","orchestration","subprocess","fallback"],"complexity":"complex"},
    {"id":"function:app.py:index","type":"function","name":"index","filePath":"app.py","lineRange":[277,375],"summary":"Handles dashboard GET and POST flows for importing patient data, selecting a numbered patient, predicting or simulating risk, generating twins, and assembling all template results.","tags":["api-handler","entry-point","dashboard","orchestration"],"complexity":"complex"},
    {"id":"file:knowledge_graph.py","type":"file","name":"knowledge_graph.py","filePath":"knowledge_graph.py","summary":"Implements the Stage 4 patient-centric knowledge graph: Neo4j persists only reusable definitions and model metadata, while complete patient observations, probabilities, SHAP contributions, and twin nodes are assembled in memory.","tags":["service","neo4j","explainability","serialization"],"complexity":"complex","languageNotes":"Uses idempotent Cypher constraints and a lock-protected lazy initializer, with a local attribute fallback when Neo4j is unavailable."},
    {"id":"function:knowledge_graph.py:classify_bmi","type":"function","name":"classify_bmi","filePath":"knowledge_graph.py","lineRange":[139,147],"summary":"Maps a nonnegative BMI value to the prototype's ordered adult BMI category definitions.","tags":["utility","classification","validation"],"complexity":"simple"},
    {"id":"function:knowledge_graph.py:_integer_code","type":"function","name":"_integer_code","filePath":"knowledge_graph.py","lineRange":[150,154],"summary":"Converts a numeric categorical value to an integer and rejects non-whole codes.","tags":["utility","validation","decoding"],"complexity":"simple"},
    {"id":"function:knowledge_graph.py:decode_feature","type":"function","name":"decode_feature","filePath":"knowledge_graph.py","lineRange":[157,173],"summary":"Decodes BRFSS feature values into dataset-grounded patient-readable states without adding clinical severity or causal interpretation.","tags":["decoding","patient-data","validation","utility"],"complexity":"simple"},
    {"id":"function:knowledge_graph.py:_format_value","type":"function","name":"_format_value","filePath":"knowledge_graph.py","lineRange":[176,178],"summary":"Formats numeric feature values compactly while preserving fractional values when present.","tags":["utility","formatting","serialization"],"complexity":"simple"},
    {"id":"function:knowledge_graph.py:_safe_id","type":"function","name":"_safe_id","filePath":"knowledge_graph.py","lineRange":[181,182],"summary":"Normalizes display strings into lowercase hyphenated identifiers for temporary graph elements.","tags":["utility","serialization","graph"],"complexity":"simple"},
    {"id":"class:knowledge_graph.py:PatientKnowledgeGraph","type":"class","name":"PatientKnowledgeGraph","filePath":"knowledge_graph.py","lineRange":[185,623],"summary":"Lazily initializes reusable Neo4j schema and model evaluation nodes, then joins them with live profile and model outputs to return a Cytoscape-ready graph without persisting patient data.","tags":["service","neo4j","explainability","fallback"],"complexity":"complex"},
    {"id":"file:stage3.py","type":"file","name":"stage3.py","filePath":"stage3.py","summary":"Provides the Stage 3 model-backed Digital Twin for three-class prediction, version-tolerant SHAP explanation, manual what-if comparison, and SMPL visual descriptors.","tags":["service","digital-twin","simulation","explainability"],"complexity":"moderate","languageNotes":"Normalizes multiple SHAP array layouts and treats simulation as a non-causal comparison of model estimates."},
    {"id":"function:stage3.py:find_model_path","type":"function","name":"find_model_path","filePath":"stage3.py","lineRange":[27,33],"summary":"Selects the first available trained model artifact from the configured candidate paths and reports all searched locations when none exists.","tags":["model-loading","configuration","utility"],"complexity":"simple"},
    {"id":"class:stage3.py:DiabetesDigitalTwin","type":"class","name":"DiabetesDigitalTwin","filePath":"stage3.py","lineRange":[36,125],"summary":"Wraps the trained risk model to validate profiles, predict class probabilities, rank patient-level SHAP factors, and compare baseline with manually edited scenarios.","tags":["service","digital-twin","simulation","explainability"],"complexity":"moderate"},
    {"id":"function:stage3.py:smpl_twin_descriptor","type":"function","name":"smpl_twin_descriptor","filePath":"stage3.py","lineRange":[128,150],"summary":"Derives a lightweight SMPL descriptor from BMI and high-risk probability, including body-shape coefficient, risk color band, and licensed-weight availability.","tags":["digital-twin","visualization","utility"],"complexity":"simple"},
    {"id":"file:test_knowledge_graph.py","type":"file","name":"test_knowledge_graph.py","filePath":"test_knowledge_graph.py","summary":"Tests the Stage 4 graph schema, decoding boundaries, temporary patient model completeness, SHAP and probability fidelity, idempotent initialization, and Neo4j-unavailable fallback behavior.","tags":["test","neo4j","explainability","validation"],"complexity":"moderate"},
    {"id":"class:test_knowledge_graph.py:FakeResult","type":"class","name":"FakeResult","filePath":"test_knowledge_graph.py","lineRange":[19,27],"summary":"Minimal iterable Neo4j result double that supports consumption in initialization tests.","tags":["test","test-double","neo4j"],"complexity":"simple"},
    {"id":"class:test_knowledge_graph.py:FakeSession","type":"class","name":"FakeSession","filePath":"test_knowledge_graph.py","lineRange":[30,52],"summary":"Context-managed Neo4j session double that records Cypher calls and returns reusable attribute definitions for graph assembly tests.","tags":["test","test-double","neo4j"],"complexity":"simple"},
    {"id":"class:test_knowledge_graph.py:FakeDriver","type":"class","name":"FakeDriver","filePath":"test_knowledge_graph.py","lineRange":[55,63],"summary":"Neo4j driver double that exposes one inspectable fake session to the graph service.","tags":["test","test-double","neo4j"],"complexity":"simple"},
    {"id":"function:test_knowledge_graph.py:example_profile","type":"function","name":"example_profile","filePath":"test_knowledge_graph.py","lineRange":[66,69],"summary":"Builds a complete 21-feature example profile with representative BMI and categorical values.","tags":["test","fixture","patient-data"],"complexity":"simple"},
    {"id":"function:test_knowledge_graph.py:example_prediction","type":"function","name":"example_prediction","filePath":"test_knowledge_graph.py","lineRange":[72,80],"summary":"Provides a deterministic high-risk prediction fixture with all three class probabilities.","tags":["test","fixture","prediction"],"complexity":"simple"},
    {"id":"function:test_knowledge_graph.py:example_contributions","type":"function","name":"example_contributions","filePath":"test_knowledge_graph.py","lineRange":[83,88],"summary":"Builds one SHAP contribution fixture for each of the 21 model features, including positive, negative, and neutral examples.","tags":["test","fixture","shap"],"complexity":"simple"},
    {"id":"function:test_knowledge_graph.py:explain","type":"function","name":"explain","filePath":"test_knowledge_graph.py","lineRange":[91,96],"summary":"Invokes the graph service with the standard profile, prediction, SHAP, twin, and model fixtures.","tags":["test","fixture","explainability"],"complexity":"simple"},
    {"id":"class:test_knowledge_graph.py:KnowledgeGraphTests","type":"class","name":"KnowledgeGraphTests","filePath":"test_knowledge_graph.py","lineRange":[99,174],"summary":"Verifies feature coverage, category decoding, complete temporary graph composition, non-causal semantics, model evidence, idempotency, and disconnected fallback behavior.","tags":["test","validation","neo4j","regression"],"complexity":"moderate"}
  ],
