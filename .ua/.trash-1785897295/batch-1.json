{
  "nodes": [
    {"id":"file:app.py","type":"file","name":"app.py","filePath":"app.py","summary":"Flask entry point for the four-stage diabetes-risk dashboard, coordinating dataset selection, prediction, SHAP explanation, manual scenarios, SMPL exports, the temporary knowledge graph, and local Ollama guidance.","tags":["entry-point","api-handler","dashboard","orchestration","digital-twin"],"complexity":"complex","languageNotes":"Uses lazy model loading and disables Flask's development reloader to avoid loading the large model twice."},
    {"id":"class:app.py:PatientDataset","type":"class","name":"PatientDataset","filePath":"app.py","lineRange":[65,140],"summary":"Validates the complete 21-feature BRFSS schema, maintains stable one-based patient numbering, and exposes patient profiles, labels, and nearby rows to every dashboard stage.","tags":["data-model","validation","dataset","patient-selection"],"complexity":"moderate"},
    {"id":"function:app.py:get_patient_dataset","type":"function","name":"get_patient_dataset","filePath":"app.py","lineRange":[146,150],"summary":"Lazily loads and caches the default BRFSS patient dataset for dashboard requests.","tags":["factory","dataset","lazy-loading"],"complexity":"simple"},
    {"id":"function:app.py:get_twin","type":"function","name":"get_twin","filePath":"app.py","lineRange":[153,158],"summary":"Lazily constructs the model-backed DiabetesDigitalTwin only when a prediction is requested.","tags":["factory","lazy-loading","digital-twin"],"complexity":"simple"},
    {"id":"function:app.py:twin_metadata","type":"function","name":"twin_metadata","filePath":"app.py","lineRange":[161,172],"summary":"Reads GLB sidecar metadata and adds a file-version timestamp, with safe fallbacks for missing or malformed metadata.","tags":["serialization","metadata","digital-twin","validation"],"complexity":"simple"},
    {"id":"function:app.py:digital_twin_asset","type":"function","name":"digital_twin_asset","filePath":"app.py","lineRange":[176,179],"summary":"Serves the current-patient GLB asset through the Flask dashboard or returns a 404 when unavailable.","tags":["api-handler","asset-serving","digital-twin"],"complexity":"simple"},
    {"id":"function:app.py:scenario_digital_twin_asset","type":"function","name":"scenario_digital_twin_asset","filePath":"app.py","lineRange":[183,186],"summary":"Serves the separately generated scenario GLB asset for current-versus-scenario comparison.","tags":["api-handler","asset-serving","scenario"],"complexity":"simple"},
    {"id":"function:app.py:refresh_smpl_twin","type":"function","name":"refresh_smpl_twin","filePath":"app.py","lineRange":[189,274],"summary":"Regenerates a profile-specific SMPL GLB with the local exporter, detects already matching output, and falls back to Docker when host dependencies are unavailable.","tags":["service","digital-twin","subprocess","containerization","fallback"],"complexity":"moderate"},
    {"id":"function:app.py:index","type":"function","name":"index","filePath":"app.py","lineRange":[278,387],"summary":"Handles the main GET/POST workflow for dataset import, patient prediction, SHAP explanation, scenario simulation, SMPL twins, Stage 4 graph construction, and optional local guidance.","tags":["api-handler","orchestration","prediction","simulation","explainability"],"complexity":"complex"},

    {"id":"file:diabetes_risk.py","type":"file","name":"diabetes_risk.py","filePath":"diabetes_risk.py","summary":"Defines the authoritative BRFSS target, ordered 21-feature model schema, risk labels, and shared dataset, patient, JSON, and model-loading utilities.","tags":["data-model","validation","model-schema","utility"],"complexity":"simple"},
    {"id":"function:diabetes_risk.py:load_dataset","type":"function","name":"load_dataset","filePath":"diabetes_risk.py","lineRange":[22,33],"summary":"Loads a BRFSS CSV, enforces the expected feature and target columns, removes incomplete rows, and validates the three target classes.","tags":["data-pipeline","validation","dataset"],"complexity":"simple"},
    {"id":"function:diabetes_risk.py:validate_patient","type":"function","name":"validate_patient","filePath":"diabetes_risk.py","lineRange":[36,48],"summary":"Ensures a patient frame has exactly one complete row and the model's 21 features in canonical order.","tags":["validation","patient-input","model-schema"],"complexity":"simple"},
    {"id":"function:diabetes_risk.py:save_json","type":"function","name":"save_json","filePath":"diabetes_risk.py","lineRange":[51,56],"summary":"Serializes dictionaries to formatted JSON while converting NumPy scalar values to native Python values.","tags":["serialization","utility","numpy"],"complexity":"simple"},
    {"id":"function:diabetes_risk.py:load_model","type":"function","name":"load_model","filePath":"diabetes_risk.py","lineRange":[59,60],"summary":"Loads a Joblib model artifact from a caller-supplied or legacy default path.","tags":["model-loading","serialization","utility"],"complexity":"simple"},

    {"id":"file:knowledge_graph.py","type":"file","name":"knowledge_graph.py","filePath":"knowledge_graph.py","summary":"Implements the Stage 4 patient-centric explanation graph: reusable feature definitions and evaluation metadata are stored in Neo4j, while patient observations, SHAP values, probabilities, and twin data remain request-local.","tags":["knowledge-graph","neo4j","explainability","privacy","stage-4"],"complexity":"complex","languageNotes":"Uses a lock-protected lazy Neo4j initialization path and a complete local fallback so patient attributes remain visible when the database is unavailable."},
    {"id":"function:knowledge_graph.py:classify_bmi","type":"function","name":"classify_bmi","filePath":"knowledge_graph.py","lineRange":[139,147],"summary":"Maps a numeric BMI to one of the prototype's configured adult BMI categories using half-open ranges.","tags":["classification","validation","bmi"],"complexity":"simple"},
    {"id":"function:knowledge_graph.py:_integer_code","type":"function","name":"_integer_code","filePath":"knowledge_graph.py","lineRange":[150,154],"summary":"Validates that a categorical model value is whole-number encoded and returns it as an integer.","tags":["validation","utility","category-code"],"complexity":"simple"},
    {"id":"function:knowledge_graph.py:decode_feature","type":"function","name":"decode_feature","filePath":"knowledge_graph.py","lineRange":[157,173],"summary":"Decodes BRFSS feature values into dataset-grounded human-readable states without adding causal medical severity claims.","tags":["decoding","serialization","model-schema","research-safety"],"complexity":"simple"},
    {"id":"function:knowledge_graph.py:_format_value","type":"function","name":"_format_value","filePath":"knowledge_graph.py","lineRange":[176,178],"summary":"Formats numeric feature values compactly while preserving non-integer precision.","tags":["formatting","utility","serialization"],"complexity":"simple"},
    {"id":"function:knowledge_graph.py:_safe_id","type":"function","name":"_safe_id","filePath":"knowledge_graph.py","lineRange":[181,182],"summary":"Normalizes arbitrary labels into lowercase hyphenated identifiers for temporary graph nodes.","tags":["utility","identifier","normalization"],"complexity":"simple"},
    {"id":"class:knowledge_graph.py:PatientKnowledgeGraph","type":"class","name":"PatientKnowledgeGraph","filePath":"knowledge_graph.py","lineRange":[185,623],"summary":"Manages reusable Neo4j definitions and assembles Cytoscape-ready, non-persisted patient explanation graphs containing all model inputs, SHAP contributions, class probabilities, evaluation warnings, and Digital Twin evidence.","tags":["service","knowledge-graph","neo4j","explainability","privacy"],"complexity":"complex"},

    {"id":"file:stage3.py","type":"file","name":"stage3.py","filePath":"stage3.py","summary":"Provides runtime loading of the notebook-trained Random Forest, ordered patient prediction, SHAP explanation, manual what-if comparison, and a compact SMPL visual descriptor.","tags":["service","prediction","explainability","simulation","digital-twin"],"complexity":"moderate"},
    {"id":"function:stage3.py:find_model_path","type":"function","name":"find_model_path","filePath":"stage3.py","lineRange":[27,33],"summary":"Returns the first available notebook-trained model artifact or reports every expected path when none exists.","tags":["model-loading","validation","artifact"],"complexity":"simple"},
    {"id":"class:stage3.py:DiabetesDigitalTwin","type":"class","name":"DiabetesDigitalTwin","filePath":"stage3.py","lineRange":[36,125],"summary":"Wraps the trained classifier with feature-order validation, three-class probabilities, version-tolerant SHAP extraction, and baseline-versus-scenario prediction comparison.","tags":["service","prediction","explainability","simulation","model-wrapper"],"complexity":"moderate"},
    {"id":"function:stage3.py:smpl_twin_descriptor","type":"function","name":"smpl_twin_descriptor","filePath":"stage3.py","lineRange":[128,150],"summary":"Converts BMI and model-estimated high-risk probability into SMPL body-shape, color-band, and model-weight availability metadata.","tags":["digital-twin","visualization","bmi","risk-band"],"complexity":"simple"},

    {"id":"file:test_knowledge_graph.py","type":"file","name":"test_knowledge_graph.py","filePath":"test_knowledge_graph.py","summary":"Focused unit tests verify the complete temporary Stage 4 patient graph, all reusable definitions and decodings, SHAP sign preservation, three probabilities, twin evidence, idempotent Neo4j initialization, and disconnected fallback behavior.","tags":["test","knowledge-graph","neo4j","explainability","regression"],"complexity":"moderate"},
    {"id":"class:test_knowledge_graph.py:FakeResult","type":"class","name":"FakeResult","filePath":"test_knowledge_graph.py","lineRange":[19,27],"summary":"Minimal iterable Neo4j result double supporting row iteration and result consumption in tests.","tags":["test","test-double","neo4j"],"complexity":"simple"},
    {"id":"class:test_knowledge_graph.py:FakeSession","type":"class","name":"FakeSession","filePath":"test_knowledge_graph.py","lineRange":[30,52],"summary":"Context-managed Neo4j session double that records Cypher calls and returns the complete reusable attribute definition set for graph tests.","tags":["test","test-double","neo4j","query-capture"],"complexity":"simple"},
    {"id":"class:test_knowledge_graph.py:FakeDriver","type":"class","name":"FakeDriver","filePath":"test_knowledge_graph.py","lineRange":[55,63],"summary":"Neo4j driver double exposing a stable FakeSession and a no-op close method.","tags":["test","test-double","neo4j"],"complexity":"simple"},
    {"id":"function:test_knowledge_graph.py:example_profile","type":"function","name":"example_profile","filePath":"test_knowledge_graph.py","lineRange":[66,69],"summary":"Builds a complete deterministic 21-feature patient profile fixture with selected categorical values.","tags":["test","fixture","patient-profile"],"complexity":"simple"},
    {"id":"function:test_knowledge_graph.py:example_prediction","type":"function","name":"example_prediction","filePath":"test_knowledge_graph.py","lineRange":[72,80],"summary":"Returns a deterministic high-risk prediction fixture with all three class probabilities.","tags":["test","fixture","prediction"],"complexity":"simple"},
    {"id":"function:test_knowledge_graph.py:example_contributions","type":"function","name":"example_contributions","filePath":"test_knowledge_graph.py","lineRange":[83,88],"summary":"Creates one SHAP contribution fixture for every model feature, including positive, negative, and neutral signs.","tags":["test","fixture","shap","explainability"],"complexity":"simple"},
    {"id":"function:test_knowledge_graph.py:explain","type":"function","name":"explain","filePath":"test_knowledge_graph.py","lineRange":[91,96],"summary":"Invokes PatientKnowledgeGraph with the deterministic profile, prediction, SHAP, twin, and model fixtures.","tags":["test","fixture","knowledge-graph"],"complexity":"simple"},
    {"id":"class:test_knowledge_graph.py:KnowledgeGraphTests","type":"class","name":"KnowledgeGraphTests","filePath":"test_knowledge_graph.py","lineRange":[99,174],"summary":"Regression suite enforcing schema coverage, decoding boundaries, the 98-node temporary graph contract, patient non-persistence, model warnings, and database-failure fallback.","tags":["test","regression","knowledge-graph","privacy","model-validation"],"complexity":"moderate"}
